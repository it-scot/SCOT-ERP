# Environment Variables
# Copy this to .env and fill in values

# Server
PORT=3001
NODE_ENV=development

# Auth
AUTH_MODE=dev
# AUTH_MODE=google
JWT_SECRET=scot-erp-dev-secret-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Data Provider
DATA_PROVIDER=mock
# DATA_PROVIDER=azuresql

# Azure SQL (when DATA_PROVIDER=azuresql)
# AZURE_SQL_SERVER=your-server.database.windows.net
# AZURE_SQL_DATABASE=scot-erp
# AZURE_SQL_USER=your-user
# AZURE_SQL_PASSWORD=your-password

# File Storage
FILE_STORAGE=local
# FILE_STORAGE=azureblob
# AZURE_BLOB_CONNECTION=your-connection-string
# AZURE_BLOB_CONTAINER=uploads

# Email
MAILER=console
# MAILER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email
# SMTP_PASS=your-password

# Google Calendar
CALENDAR_PROVIDER=local
# CALENDAR_PROVIDER=google
# GOOGLE_CALENDAR_CREDENTIALS=path/to/credentials.json
# GOOGLE_CALENDAR_ID=primary

# Google Auth (when AUTH_MODE=google)
# GOOGLE_CLIENT_ID=your-client-id

# CORS
CORS_ORIGIN=http://localhost:5173

# Device API Key (for biometric punch endpoint)
DEVICE_API_KEY=biometric-dev-key
